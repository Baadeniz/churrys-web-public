<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Churry's — Home Of The American Burgers · Merlo, San Luis</title>
<meta name="description" content="Hamburguesas artesanales en Merlo, San Luis. Mirá el despiece de cada una, capa por capa, y pedí por WhatsApp.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Lobster+Two:ital,wght@1,700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --rojo:#C20C0B;
  --rojo-vivo:#D82828;
  --bordo:#6E0000;
  --bordo-hondo:#4A0202;
  --crema:#FAF5F1;
  --crema-humo:#F0E8E8;
  --oro:#F2B22E;
  --tinta:#2A1210;

  --display:'Alfa Slab One', Rockwell, Georgia, serif;
  --script:'Lobster Two', 'Brush Script MT', cursive;
  --sans:'Poppins', system-ui, -apple-system, 'Segoe UI', sans-serif;

  --pad:clamp(18px,5vw,64px);
}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-padding-top:88px}
body{
  margin:0;background:var(--crema);color:var(--tinta);
  font-family:var(--sans);font-weight:500;overflow-x:hidden;
}
img{display:block;max-width:100%;-webkit-user-drag:none;user-select:none}
a{color:inherit}
button{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--oro);outline-offset:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* ---------- damero de la marca ---------- */
.rail{
  --sq:clamp(10px,2.6vw,16px);
  --c:var(--crema);
  height:calc(var(--sq)*2);width:100%;
  background-image:
    repeating-linear-gradient(90deg,var(--c) 0 var(--sq),transparent var(--sq) calc(var(--sq)*2)),
    repeating-linear-gradient(90deg,transparent 0 var(--sq),var(--c) var(--sq) calc(var(--sq)*2));
  background-size:100% 50%,100% 50%;
  background-position:0 0,0 100%;
  background-repeat:no-repeat;
}
.rail.rojo{--c:var(--rojo-vivo)}
.stars{color:var(--rojo-vivo);letter-spacing:.34em;font-size:.9rem;line-height:1}

/* ---------- barra superior ---------- */
.top{background:var(--rojo)}
header{background:var(--crema);position:sticky;top:0;z-index:60;border-bottom:3px solid var(--rojo)}
.nav{max-width:1240px;margin:0 auto;padding:10px var(--pad);display:flex;align-items:center;gap:14px}
.nav .logo{width:clamp(112px,20vw,164px);mix-blend-mode:multiply}
.nav .sp{flex:1}
.nav .ig{
  font-weight:700;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;
  text-decoration:none;color:var(--rojo);white-space:nowrap;
}
.nav .ig:hover{text-decoration:underline}
@media(max-width:520px){.nav .ig{display:none}}

/* ---------- botones ---------- */
.cta{
  display:inline-flex;align-items:center;gap:10px;
  background:var(--rojo-vivo);color:var(--crema);
  font-family:var(--display);font-size:clamp(.95rem,2.4vw,1.08rem);
  text-decoration:none;padding:14px 22px;
  border:3px solid var(--bordo);border-radius:4px;box-shadow:5px 5px 0 var(--bordo);
  transition:transform .12s ease, box-shadow .12s ease, background .2s;
}
.cta:hover{background:#E33A3A;transform:translate(-2px,-2px);box-shadow:7px 7px 0 var(--bordo)}
.cta:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--bordo)}
.cta.chico{padding:9px 15px;font-size:.85rem;box-shadow:3px 3px 0 var(--bordo)}
.cta.chico:hover{box-shadow:5px 5px 0 var(--bordo)}
.cta.claro{background:var(--crema);color:var(--rojo)}
.cta.claro:hover{background:#fff}
.wa{width:1.05em;height:1.05em;flex:none}

/* ---------- hero ---------- */
.hero{background:var(--rojo);color:var(--crema-humo);position:relative}
.hero-in{
  max-width:1240px;margin:0 auto;
  padding:clamp(26px,5vw,52px) var(--pad) clamp(34px,6vw,62px);
  display:grid;gap:clamp(24px,4vw,34px);grid-template-columns:1fr;
}
.col-titulo{order:1}.col-visual{order:2}.col-info{order:3}
@media(min-width:900px){
  .hero-in{
    grid-template-columns:minmax(300px,410px) 1fr;
    align-items:start;column-gap:clamp(28px,4.5vw,56px);row-gap:0;
  }
  .col-visual{grid-column:1;grid-row:1 / span 2}
  .col-titulo{grid-column:2;grid-row:1}
  .col-info{grid-column:2;grid-row:2}
}
.eyebrow{
  display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 12px;
  font-size:.7rem;font-weight:800;letter-spacing:.24em;text-transform:uppercase;color:#F8B9B4;
}
h1{
  font-family:var(--display);font-weight:400;margin:0;
  font-size:clamp(2.4rem,9.5vw,4.2rem);line-height:.94;
  color:var(--crema);text-shadow:5px 5px 0 var(--bordo-hondo);text-transform:uppercase;
}
.tag{
  font-family:var(--script);font-style:italic;font-weight:700;
  font-size:clamp(1.15rem,3.6vw,1.6rem);color:#FFD9C9;margin:14px 0 0;line-height:1.15;
}

/* precio + compra */
.buy{display:flex;align-items:center;gap:clamp(14px,3vw,24px);flex-wrap:wrap;margin:0}
.ticket{
  position:relative;background:var(--crema);color:var(--rojo);
  padding:10px 26px 12px;border-radius:5px;flex:none;box-shadow:0 8px 18px rgba(0,0,0,.22);
}
.ticket::before,.ticket::after{
  content:'';position:absolute;width:18px;height:18px;border-radius:50%;
  background:var(--rojo);top:50%;transform:translateY(-50%);
}
.ticket::before{left:-10px}
.ticket::after{right:-10px}
.ticket .lbl{
  font-size:.58rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase;
  color:#C08882;display:block;
}
.ticket .num{font-family:var(--display);font-size:clamp(1.6rem,5.4vw,2.05rem);line-height:1.15;display:block}
.ticket .perf{
  position:absolute;left:9px;right:9px;bottom:4px;height:2px;
  background:repeating-linear-gradient(90deg,#E4D2CC 0 5px,transparent 5px 10px);
}

/* selector */
.tabs{
  display:flex;flex-wrap:wrap;gap:8px;margin:26px 0 0;
  border-top:2px dashed rgba(255,255,255,.28);padding-top:18px;
}
.eq{
  width:100%;font-size:.66rem;font-weight:800;letter-spacing:.22em;
  text-transform:uppercase;color:#F0A6A0;margin:0 0 4px;
}
.tab{
  background:transparent;border:2px solid rgba(250,245,241,.42);color:var(--crema-humo);
  border-radius:999px;padding:8px 15px;cursor:pointer;
  font-size:.76rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
  transition:background .18s,border-color .18s,color .18s;
}
.tab:hover{border-color:var(--crema)}
.tab[aria-pressed="true"]{background:var(--crema);border-color:var(--crema);color:var(--rojo)}

/* controles */
.ctrls{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0 0}
.ghost{
  background:transparent;border:2px solid var(--crema-humo);color:var(--crema);
  border-radius:4px;padding:10px 16px;cursor:pointer;
  font-size:.76rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  display:inline-flex;align-items:center;gap:9px;transition:background .18s,color .18s;
}
.ghost:hover{background:rgba(255,255,255,.14)}
.ghost[aria-pressed="true"]{background:var(--crema);color:var(--rojo)}
.ghost .dot{width:8px;height:8px;border-radius:50%;background:currentColor;flex:none}
.hint{font-size:.8rem;color:#F3B3AD;margin:12px 0 0;line-height:1.55}

/* ---------- el despiece ---------- */
.stage{
  position:relative;width:min(100%,410px);margin:0 auto;height:380px;
  transition:height .62s cubic-bezier(.22,.8,.25,1);
}
.layer{
  position:absolute;left:50%;top:0;padding:0;border:0;background:none;
  cursor:pointer;-webkit-tap-highlight-color:transparent;transform-origin:50% 0;
  transition:transform .62s cubic-bezier(.22,.8,.25,1);
}
.bob{display:block;animation:bob 6.5s ease-in-out infinite;animation-delay:var(--d,0s)}
.layer img{
  --fx:1;width:100%;height:auto;transform:scaleX(var(--fx));
  filter:var(--tint,) drop-shadow(0 6px 10px rgba(60,0,0,.34));
  transition:transform .32s cubic-bezier(.3,1.35,.4,1), filter .3s, opacity .3s;
}
.layer.flip img{--fx:-1}
.layer.tint img{--tint:saturate(1.5) sepia(.4) hue-rotate(-16deg) contrast(1.06)}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}

.stage.picked .layer:not(.on) img{
  opacity:.4;filter:var(--tint,) saturate(.4) drop-shadow(0 4px 6px rgba(60,0,0,.2));
}
.layer.on img{
  transform:translateX(5%) scale(1.05) scaleX(var(--fx));
  filter:var(--tint,) drop-shadow(-15px 12px 16px rgba(40,0,0,.5));
}
.stage.closed .layer.on img{transform:translateX(14%) scale(1.03) scaleX(var(--fx))}

/* lectura de la capa activa */
.readout{
  margin:20px auto 0;width:min(100%,430px);
  background:var(--bordo-hondo);border:2px solid rgba(255,255,255,.2);border-radius:6px;
  padding:14px 16px;min-height:108px;
}
.readout .n{font-family:var(--display);font-size:.86rem;color:var(--oro);line-height:1}
.readout h3{
  font-family:var(--display);font-weight:400;margin:7px 0 6px;
  font-size:clamp(1.05rem,3.4vw,1.28rem);color:var(--crema);text-transform:uppercase;line-height:1.05;
}
.readout p{margin:0;font-size:.85rem;line-height:1.5;color:#E9C9C4}

/* lista de ingredientes */
.build{margin:26px 0 0;border-top:2px dashed rgba(255,255,255,.28);padding-top:18px}
.build .eq{display:flex;justify-content:space-between;gap:10px;margin-bottom:8px}
.rows{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
.rows button{
  width:100%;display:flex;align-items:baseline;gap:12px;text-align:left;
  background:transparent;border:0;border-radius:4px;padding:8px 10px;cursor:pointer;
  transition:background .18s,color .18s;
}
.rows button:hover{background:rgba(255,255,255,.12)}
.rows .num{font-family:var(--display);font-size:.76rem;color:#F0A6A0;flex:none;width:22px;transition:color .18s}
.rows .nm{font-weight:700;font-size:.94rem;color:var(--crema)}
.rows li.on button{background:var(--crema)}
.rows li.on .nm{color:var(--rojo)}
.rows li.on .num{color:var(--rojo-vivo)}

/* ---------- marquesina ---------- */
.marquee{
  background:var(--bordo);overflow:hidden;padding:11px 0;
  border-top:3px solid var(--bordo-hondo);border-bottom:3px solid var(--bordo-hondo);
}
.marquee div{display:flex;width:max-content;animation:slide 36s linear infinite}
.marquee span{
  font-family:var(--display);font-size:.82rem;letter-spacing:.12em;color:var(--crema-humo);
  padding-right:26px;white-space:nowrap;text-transform:uppercase;
}
.marquee i{color:var(--oro);font-style:normal;padding-right:26px}
@keyframes slide{to{transform:translateX(-50%)}}

/* ---------- la carta ---------- */
.carta{max-width:1240px;margin:0 auto;padding:clamp(40px,7vw,78px) var(--pad)}
.head{margin:0 0 clamp(24px,4vw,38px)}
.head .k{font-size:.68rem;font-weight:800;letter-spacing:.24em;text-transform:uppercase;color:#B4756F;margin:0}
.head h2{
  font-family:var(--display);font-weight:400;margin:8px 0 0;
  font-size:clamp(2rem,7vw,3.1rem);line-height:.96;color:var(--rojo);
  text-shadow:4px 4px 0 rgba(110,0,0,.16);text-transform:uppercase;
}
.head p{margin:12px 0 0;max-width:52ch;font-size:.95rem;line-height:1.6;color:#5B3A36}

.grid{display:grid;gap:clamp(16px,2.4vw,22px);grid-template-columns:1fr}
@media(min-width:640px){.grid{grid-template-columns:1fr 1fr}}
@media(min-width:1060px){.grid{grid-template-columns:repeat(4,1fr)}}

.card{
  background:#fff;border:3px solid var(--rojo);border-radius:8px;
  box-shadow:6px 6px 0 rgba(194,12,11,.15);
  display:flex;flex-direction:column;overflow:hidden;
}
.shot{
  background:var(--rojo);height:224px;padding:0 10px 12px;
  display:flex;align-items:flex-end;justify-content:center;
}
.mini{position:relative;width:196px;flex:none}
.mini img{position:absolute;left:50%;top:0;filter:drop-shadow(0 5px 7px rgba(50,0,0,.4))}
.card .body{padding:16px;display:flex;flex-direction:column;gap:9px;flex:1}
.card h3{font-family:var(--display);font-weight:400;margin:0;font-size:1.26rem;line-height:1;color:var(--rojo);text-transform:uppercase}
.card .sub{font-family:var(--script);font-style:italic;font-weight:700;color:#8A4A45;font-size:1rem;margin:-3px 0 0}
.card .ing{margin:0;font-size:.79rem;line-height:1.55;color:#6B4640;flex:1}
.card .foot{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.card .pr{font-family:var(--display);font-size:1.28rem;color:var(--tinta)}
.card .lnk{
  background:none;border:0;padding:0 0 2px;cursor:pointer;
  font-size:.7rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
  color:var(--rojo);border-bottom:2px solid var(--rojo);
}
.card .lnk:hover{color:var(--bordo);border-color:var(--bordo)}

/* ---------- cómo pedir ---------- */
.pedir{background:var(--crema-humo);border-top:3px solid var(--rojo)}
.pedir-in{max-width:1240px;margin:0 auto;padding:clamp(40px,7vw,74px) var(--pad)}
.info{display:grid;gap:clamp(16px,2.4vw,24px);grid-template-columns:1fr;margin:clamp(22px,4vw,34px) 0 0}
@media(min-width:760px){.info{grid-template-columns:repeat(3,1fr)}}
.info div{background:var(--crema);border-left:5px solid var(--rojo-vivo);padding:18px 20px;border-radius:0 6px 6px 0}
.info h3{font-family:var(--display);font-weight:400;margin:0 0 8px;font-size:.98rem;text-transform:uppercase;color:var(--rojo)}
.info p{margin:0;font-size:.89rem;line-height:1.6;color:#4E322E}
.info a{color:var(--rojo);font-weight:700;text-decoration:none;border-bottom:2px solid rgba(194,12,11,.3)}
.cierre{
  margin:clamp(28px,5vw,42px) 0 0;padding:clamp(22px,4vw,32px);
  background:var(--rojo);border-radius:8px;color:var(--crema);
  display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;
}
.cierre p{margin:0;font-family:var(--display);font-size:clamp(1.15rem,3.6vw,1.65rem);line-height:1.15;text-transform:uppercase}
.cierre small{
  display:block;font-family:var(--sans);font-weight:600;font-size:.76rem;
  letter-spacing:.06em;color:#F7BDB7;margin-top:8px;text-transform:none;
}

footer{background:var(--bordo-hondo);color:#D9AFAA;text-align:center;padding:34px var(--pad) 40px}
footer .logo{width:146px;margin:0 auto 18px;background:var(--crema);padding:13px 18px;border-radius:999px;box-shadow:0 8px 20px rgba(0,0,0,.32)}
footer p{margin:0;font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;line-height:1.9}
footer a{color:var(--crema-humo);text-decoration:none;border-bottom:1px solid rgba(250,245,241,.35)}

@media (prefers-reduced-motion: reduce){
  .bob,.marquee div{animation:none}
  .stage,.layer,.layer img,.cta{transition-duration:.01ms}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>

<div class="top"><div class="rail"></div></div>

<header>
  <div class="nav">
    <img class="logo" id="logo-nav" alt="Churry's">
    <span class="sp"></span>
    <a class="ig" href="https://www.instagram.com/churrys_ar/" target="_blank" rel="noopener">@churrys_ar</a>
    <a class="cta chico" href="https://wa.link/zgtzxk" target="_blank" rel="noopener">Pedir</a>
  </div>
</header>

<main>
<section class="hero">
  <div class="hero-in">

    <div class="col-titulo">
      <p class="eyebrow"><span class="stars" aria-hidden="true">★★★★★</span> El despiece</p>
      <h1 id="b-name">Crispy</h1>
      <p class="tag" id="b-tag"></p>
    </div>

    <div class="col-visual">
      <div class="stage closed" id="stage"></div>
      <div class="readout" id="readout" role="status" aria-live="polite"></div>
    </div>

    <div class="col-info">
      <div class="buy">
        <div class="ticket">
          <span class="lbl">Precio</span>
          <span class="num" id="b-price">$15.000</span>
          <span class="perf" aria-hidden="true"></span>
        </div>
        <a class="cta" href="https://wa.link/zgtzxk" target="_blank" rel="noopener">
          <svg class="wa" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.16 8.16 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.16 1.73 2.64 4.19 3.7.58.25 1.04.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.11-.23-.17-.48-.29Z"/></svg>
          Pedir por WhatsApp
        </a>
      </div>

      <div class="tabs" id="tabs">
        <p class="eq">Cambiá de hamburguesa</p>
      </div>

      <div class="ctrls">
        <button class="ghost" id="btn-open" type="button" aria-pressed="false">Desarmar</button>
        <button class="ghost" id="btn-tour" type="button" aria-pressed="false"><span class="dot" aria-hidden="true"></span><span id="tour-txt">Recorrer ingredientes</span></button>
      </div>
      <p class="hint">Tocá cualquier capa de la hamburguesa —o cualquier renglón de la lista— y te cuento qué es.</p>

      <div class="build">
        <p class="eq"><span>De arriba hacia abajo</span><span id="b-count"></span></p>
        <ul class="rows" id="rows"></ul>
      </div>
    </div>

  </div>
  <div class="rail"></div>
</section>

<div class="marquee" aria-hidden="true"><div id="mq"></div></div>

<section class="carta" id="carta">
  <div class="head">
    <p class="k">La carta · cuatro hamburguesas</p>
    <h2>Todas se abren</h2>
    <p>Elegí una y mirala por dentro, capa por capa. Todas se armaron para comerse con la mano, en el local o donde estés.</p>
  </div>
  <div class="grid" id="grid"></div>
</section>

<section class="pedir">
  <div class="pedir-in">
    <div class="head">
      <p class="k">Cómo pedir</p>
      <h2>Estamos a un mensaje</h2>
    </div>
    <div class="info">
      <div>
        <h3>Dónde</h3>
        <p>Carlos Alric 732<br>Merlo, San Luis</p>
      </div>
      <div>
        <h3>Cuándo</h3>
        <p>Lunes a sábados por la noche.<br>Abrimos 19:30 y la plancha sigue hasta las 23.</p>
      </div>
      <div>
        <h3>Retiro o delivery</h3>
        <p>Escribinos por WhatsApp, te confirmamos el tiempo y elegís si la retirás o te la llevamos.<br><a href="https://www.instagram.com/churrys_ar/" target="_blank" rel="noopener">@churrys_ar</a></p>
      </div>
    </div>
    <div class="cierre">
      <p>Hacé tu pedido<small>Te respondemos por WhatsApp mientras haya stock</small></p>
      <a class="cta claro" href="https://wa.link/zgtzxk" target="_blank" rel="noopener">
        <svg class="wa" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.16 8.16 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.12.16 1.73 2.64 4.19 3.7.58.25 1.04.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.68-1.18.2-.58.2-1.08.14-1.18-.06-.11-.23-.17-.48-.29Z"/></svg>
        Pedir por WhatsApp
      </a>
    </div>
  </div>
  <div class="rail rojo"></div>
</section>
</main>

<footer>
  <img class="logo" id="logo-foot" alt="Churry's">
  <p>Home of the american burgers</p>
  <p>Merlo, San Luis · <a href="https://www.instagram.com/churrys_ar/" target="_blank" rel="noopener">@churrys_ar</a></p>
</footer>

<script>
/* ============ recortes de la foto original, capa por capa ============ */
const A = {"src": {"pan-papa": "data:image/webp;base64,", "salsa": "data:image/webp;base64,", "cebolla": "data:image/webp;base64,", "panceta": "data:image/webp;base64,", "cheddar": "data:image/webp;base64,", "medallon": "data:image/webp;base64,", "provolone": "data:image/webp;base64,", "pan": "data:image/webp;base64,", "logo": "data:image/webp;base64,"}, "dim": {"pan-papa": [512, 225], "salsa": [501, 89], "cebolla": [621, 167], "panceta": [584, 113], "cheddar": [545, 121], "medallon": [529, 157], "provolone": [560, 146], "pan": [528, 169]}};
const SRC = A.src, DIM = A.dim;

/* ============ ingredientes ============ */
const ING = {
  'pan-papa':{n:'Pan de papa',d:'Potato bun tostado en la plancha. Dulce, aireado y firme: aguanta todo el jugo sin deshacerse.'},
  'salsa':{n:'Salsa churry',d:'La salsa de la casa. Cremosa, con ajo y un final ahumado. La receta no se cuenta.'},
  'cebolla':{n:'Cebolla crispy',d:'Tiras finas de cebolla rebozadas y fritas al momento. Este es el crunch que le da el nombre.'},
  'panceta':{n:'Panceta',d:'Panceta ahumada, dorada en la plancha hasta que se quiebra sola.'},
  'cheddar':{n:'Cheddar',d:'La feta va sobre el medallón recién salido del fuego, para que se funda hasta el borde.'},
  'medallon':{n:'Medallón de carne',d:'160 g de carne fresca, sellada a fuego fuerte para que quede jugosa adentro.'},
  'provolone':{n:'Queso provolone',d:'Provolone fundido debajo del medallón. El toque bien argentino de la casa.'},
  'pan':{n:'Base de pan de papa',d:'La base, tostada con manteca sobre la plancha. Cierra el sándwich y sostiene todo.'}
};

/* grosor visible de cada capa cuando la hamburguesa está armada */
const TH = {'pan-papa':160,'salsa':8,'cebolla':50,'panceta':40,'cheddar':24,'medallon':90,'provolone':30,'pan':169};

const SW = 620;      /* ancho del sistema de coordenadas del despiece */
const OPEN_S = 0.78; /* escala de las capas cuando se separan */
const GAP = 16;      /* aire entre capas separadas */

const L = (k,o) => Object.assign({k,n:ING[k].n,d:ING[k].d}, o||{});

const BURGERS = [
  { id:'crispy', name:'Crispy', price:15000,
    tag:'La que nos hizo conocidos.',
    resumen:'Pan de papa, salsa churry, cebolla crispy, panceta, cheddar, medallón y provolone.',
    stack:[L('pan-papa'),L('salsa'),L('cebolla'),L('panceta'),L('cheddar'),L('medallon'),L('provolone'),L('pan')] },

  { id:'doble', name:'Doble Churry', price:19500,
    tag:'Dos medallones, dos cheddar, cero vueltas.',
    resumen:'Doble medallón, doble cheddar, panceta ahumada y salsa churry.',
    stack:[L('pan-papa'),L('salsa'),L('panceta'),L('cheddar'),L('medallon'),
           L('cheddar',{n:'Segundo cheddar',flip:1,d:'La segunda feta va entre los dos medallones, así se funde por las dos caras.'}),
           L('medallon',{n:'Segundo medallón',flip:1,d:'Otros 160 g. Van los dos a la plancha al mismo tiempo para que salgan igual de calientes.'}),
           L('pan')] },

  { id:'provo', name:'Provo Bacon', price:16500,
    tag:'Provolone fundido y panceta. Nada más.',
    resumen:'Provolone fundido, panceta ahumada, medallón y salsa churry.',
    stack:[L('pan-papa'),L('salsa'),L('panceta'),
           L('provolone',{d:'Acá el provolone va arriba del medallón y se funde contra la panceta caliente.'}),
           L('medallon'),L('pan')] },

  { id:'honey', name:'Honey Onion', price:16000,
    tag:'Dulce arriba, salado abajo.',
    resumen:'Salsa honey mustard, cebolla crispy, cheddar y medallón.',
    stack:[L('pan-papa'),
           L('salsa',{n:'Salsa honey mustard',tint:1,d:'Miel, mostaza y un golpe de vinagre. Arranca dulce y termina con punta ácida.'}),
           L('cebolla'),L('cheddar'),L('medallon'),L('pan')] }
];

const money = v => '$' + v.toLocaleString('es-AR');

/* ============ estado ============ */
let cur = BURGERS[0], open = false, pick = -1, tour = null, lastW = 0;

const stage   = document.getElementById('stage');
const rowsEl  = document.getElementById('rows');
const readout = document.getElementById('readout');
const tabsEl  = document.getElementById('tabs');
const btnOpen = document.getElementById('btn-open');
const btnTour = document.getElementById('btn-tour');
const tourTxt = document.getElementById('tour-txt');

document.getElementById('logo-nav').src  = SRC.logo;
document.getElementById('logo-foot').src = SRC.logo;

/* ============ geometría ============ */
function place(stack, isOpen){
  const pos = []; let y = 0;
  stack.forEach((it,i)=>{
    const s = isOpen ? OPEN_S : 1;
    pos.push({y:y, s:s});
    y += isOpen ? DIM[it.k][1]*s + GAP
                : (i === stack.length-1 ? DIM[it.k][1] : TH[it.k]);
  });
  return { pos:pos, total: isOpen ? y - GAP : y };
}

function draw(){
  const k = stage.clientWidth / SW;
  if(!k) return;
  lastW = stage.clientWidth;
  const p = place(cur.stack, open);
  stage.style.height = (p.total*k) + 'px';
  Array.prototype.forEach.call(stage.children, function(el,i){
    const w = DIM[cur.stack[i].k][0]*k;
    el.style.width = w + 'px';
    el.style.transform = 'translate3d(' + (-w/2) + 'px,' + (p.pos[i].y*k) + 'px,0) scale(' + p.pos[i].s + ')';
  });
}

/* ============ construir la hamburguesa activa ============ */
function build(){
  stage.innerHTML = '';
  rowsEl.innerHTML = '';

  cur.stack.forEach(function(it,i){
    const b = document.createElement('button');
    b.className = 'layer' + (it.flip ? ' flip' : '') + (it.tint ? ' tint' : '');
    b.type = 'button';
    b.tabIndex = -1;
    b.setAttribute('aria-hidden','true');
    b.style.zIndex = cur.stack.length - i;

    const bob = document.createElement('span');
    bob.className = 'bob';
    bob.style.setProperty('--d', (i*0.42) + 's');

    const img = document.createElement('img');
    img.src = SRC[it.k]; img.alt = '';
    bob.appendChild(img); b.appendChild(bob); stage.appendChild(b);

    b.addEventListener('click', function(){ select(i === pick ? -1 : i) });
    b.addEventListener('mouseenter', function(){ if(!tour) paint(i) });
    b.addEventListener('mouseleave', function(){ if(!tour) paint(pick) });

    const li = document.createElement('li');
    const rb = document.createElement('button');
    rb.type = 'button';
    rb.innerHTML = '<span class="num">' + String(i+1).padStart(2,'0') + '</span><span class="nm"></span>';
    rb.querySelector('.nm').textContent = it.n;
    rb.addEventListener('click', function(){ select(i === pick ? -1 : i) });
    rb.addEventListener('mouseenter', function(){ if(!tour) paint(i) });
    rb.addEventListener('mouseleave', function(){ if(!tour) paint(pick) });
    li.appendChild(rb); rowsEl.appendChild(li);
  });

  document.getElementById('b-name').textContent  = cur.name;
  document.getElementById('b-tag').textContent   = cur.tag;
  document.getElementById('b-price').textContent = money(cur.price);
  document.getElementById('b-count').textContent = cur.stack.length + ' capas';

  pick = -1;
  paint(-1);
  draw();
}

/* ============ resaltado ============ */
function paint(i){
  const on = i >= 0;
  stage.classList.toggle('picked', on);
  Array.prototype.forEach.call(stage.children, function(el,j){ el.classList.toggle('on', j===i) });
  Array.prototype.forEach.call(rowsEl.children, function(el,j){ el.classList.toggle('on', j===i) });

  const n = readout;
  if(on){
    const it = cur.stack[i];
    n.innerHTML = '<span class="n">Capa ' + String(i+1).padStart(2,'0') + ' de ' + String(cur.stack.length).padStart(2,'0') + '</span><h3></h3><p></p>';
    n.querySelector('h3').textContent = it.n;
    n.querySelector('p').textContent  = it.d;
  }else{
    n.innerHTML = '<span class="n">' + cur.stack.length + ' capas</span><h3></h3><p></p>';
    n.querySelector('h3').textContent = cur.name;
    n.querySelector('p').textContent  = cur.resumen;
  }
}
function select(i){ endTour(); pick = i; paint(i) }

/* ============ armar / desarmar ============ */
function setOpen(v){
  open = v;
  stage.classList.toggle('closed', !open);
  btnOpen.textContent = open ? 'Armar de nuevo' : 'Desarmar';
  btnOpen.setAttribute('aria-pressed', open ? 'true' : 'false');
  draw();
}
btnOpen.addEventListener('click', function(){ endTour(); setOpen(!open) });

/* ============ recorrido automático, capa por capa ============ */
function endTour(){
  if(tour){ clearInterval(tour); tour = null }
  btnTour.setAttribute('aria-pressed','false');
  tourTxt.textContent = 'Recorrer ingredientes';
}
btnTour.addEventListener('click', function(){
  if(tour){ endTour(); return }
  if(!open) setOpen(true);
  let i = -1;
  btnTour.setAttribute('aria-pressed','true');
  tourTxt.textContent = 'Detener';
  const step = function(){
    i++;
    if(i >= cur.stack.length){ endTour(); pick = -1; paint(-1); return }
    pick = i; paint(i);
  };
  step();
  tour = setInterval(step, 1500);
});

/* ============ selector de hamburguesa ============ */
BURGERS.forEach(function(b,i){
  const t = document.createElement('button');
  t.className = 'tab'; t.type = 'button'; t.textContent = b.name;
  t.dataset.id = b.id;
  t.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
  t.addEventListener('click', function(){ pickBurger(b) });
  tabsEl.appendChild(t);
});
function pickBurger(b){
  endTour();
  cur = b;
  tabsEl.querySelectorAll('.tab').forEach(function(t){
    t.setAttribute('aria-pressed', t.dataset.id === b.id ? 'true' : 'false');
  });
  build();
}

/* ============ la carta ============ */
const grid = document.getElementById('grid');
const MK = 196/SW;
BURGERS.forEach(function(b){
  const p = place(b.stack, false);
  const layers = b.stack.map(function(it,i){
    const w = DIM[it.k][0]*MK;
    const tr = 'translate(' + (-w/2) + 'px,' + (p.pos[i].y*MK) + 'px)' + (it.flip ? ' scaleX(-1)' : '');
    const fl = it.tint
      ? 'filter:saturate(1.5) sepia(.4) hue-rotate(-16deg) contrast(1.06) drop-shadow(0 5px 7px rgba(50,0,0,.4));'
      : '';
    return '<img src="' + SRC[it.k] + '" alt="" style="width:' + w + 'px;transform:' + tr +
           ';z-index:' + (b.stack.length-i) + ';' + fl + '">';
  }).join('');

  const card = document.createElement('article');
  card.className = 'card';
  card.innerHTML =
    '<div class="shot"><div class="mini" style="height:' + (p.total*MK) + 'px">' + layers + '</div></div>' +
    '<div class="body"><h3></h3><p class="sub"></p><p class="ing"></p>' +
    '<div class="foot"><span class="pr"></span><button class="lnk" type="button">Ver el despiece</button></div>' +
    '<a class="cta chico" href="https://wa.link/zgtzxk" target="_blank" rel="noopener" style="align-self:flex-start">Pedir esta</a></div>';
  card.querySelector('h3').textContent  = b.name;
  card.querySelector('.sub').textContent = b.tag;
  card.querySelector('.ing').textContent = b.resumen;
  card.querySelector('.pr').textContent  = money(b.price);
  card.querySelector('.lnk').addEventListener('click', function(){
    pickBurger(b);
    setOpen(true);
    document.querySelector('.hero').scrollIntoView({behavior:'smooth',block:'start'});
  });
  grid.appendChild(card);
});

/* ============ marquesina ============ */
document.getElementById('mq').innerHTML =
  ['Home of the american burgers','Merlo, San Luis','Retiro y delivery','Lunes a sábados por la noche']
  .map(function(f){ return '<span>' + f + '</span><i>★</i>' }).join('').repeat(4);

/* ============ arranque ============ */
build();
new ResizeObserver(function(){
  if(Math.abs(stage.clientWidth - lastW) > 0.5) draw();
}).observe(stage);
window.addEventListener('load', draw);
</script>
</body>
</html>
